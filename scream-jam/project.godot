; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://FMOD/banks"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Scream-Jam"
run/main_scene="res://Scenes/Managers/SceneManager.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.png"

[autoload]

Global="*res://Scripts/global.gd"
JsonParser="*res://Scripts/JsonParser/JsonParser.gd"
AudioManager="*res://Scripts/Base/AudioManager.tscn"
FmodManager="*res://Addons/fmod/FmodManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=false
window/size/borderless=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"
<<<<<<<Updatedupstreamwindow/size/borderless=true

[dotnet]

project/assembly_name="Scream-Jam"

[editor_plugins]

enabled=PackedStringArray("res://addons/fmod/plugin.cfg")

